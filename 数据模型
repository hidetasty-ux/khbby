datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id     Int     @id @default(autoincrement())
  phone  String  @unique
  name   String?
  pets   Pet[]
  orders Order[]
}

model Pet {
  id      Int     @id @default(autoincrement())
  name    String
  species String
  owner   User    @relation(fields: [ownerId], references: [id])
  ownerId Int
  orders  Order[]
}

model Provider {
  id       Int       @id @default(autoincrement())
  name     String
  address  String
  rating   Float     @default(5.0)
  services Service[]
  orders   Order[]
}

model Service {
  id         Int      @id @default(autoincrement())
  name       String
  price      Float
  provider   Provider @relation(fields: [providerId], references: [id])
  providerId Int
  orders     Order[]
}

model Order {
  id         Int       @id @default(autoincrement())
  status     String
  totalPrice Float
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
  userId     Int
  provider   Provider  @relation(fields: [providerId], references: [id])
  providerId Int
  pet        Pet       @relation(fields: [petId], references: [id])
  petId      Int
  services   Service[]
}
